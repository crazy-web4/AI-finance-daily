{
  "$defs": {
    "SourceReliability": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "SourceReliability",
      "type": "string"
    }
  },
  "description": "归一化后的原始新闻文章（单一事实源，采集/聚类/分析共用）。",
  "properties": {
    "article_id": {
      "description": "文章唯一ID（sha256(归一化url)前12位）",
      "title": "Article Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    },
    "source_domain": {
      "title": "Source Domain",
      "type": "string"
    },
    "source_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Name"
    },
    "content": {
      "default": "",
      "description": "正文内容，纯文本",
      "title": "Content",
      "type": "string"
    },
    "snippet": {
      "default": "",
      "title": "Snippet",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "业务分类标签（来自查询打标）",
      "title": "Category"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "country": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "search_query": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Search Query"
    },
    "search_batch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Search Batch"
    },
    "source_reliability": {
      "$ref": "#/$defs/SourceReliability",
      "default": "unknown"
    },
    "result_count": {
      "default": 1,
      "description": "在多少条查询中出现",
      "title": "Result Count",
      "type": "integer"
    }
  },
  "required": [
    "article_id",
    "title",
    "url",
    "source_domain",
    "fetched_at"
  ],
  "title": "RawNewsArticle",
  "type": "object"
}