{
  "$defs": {
    "EventType": {
      "enum": [
        "model_release",
        "model_update",
        "api_launch",
        "funding_round",
        "acquisition",
        "partnership",
        "policy_change",
        "regulation_update",
        "research_breakthrough",
        "product_launch",
        "chip_hardware",
        "datacenter_infra",
        "company_strategy",
        "lawsuit_legal",
        "market_data",
        "safety_security",
        "other"
      ],
      "title": "EventType",
      "type": "string"
    },
    "FactCheckCategoryResult": {
      "description": "每个核查类别的结果。",
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/FactCheckIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "category",
        "passed",
        "confidence"
      ],
      "title": "FactCheckCategoryResult",
      "type": "object"
    },
    "FactCheckIssue": {
      "description": "核查发现的问题。",
      "properties": {
        "severity": {
          "pattern": "^(critical|warning|info)$",
          "title": "Severity",
          "type": "string"
        },
        "category": {
          "description": "所属核查类别: time/numbers/entities/sources/logic",
          "title": "Category",
          "type": "string"
        },
        "description": {
          "description": "问题描述",
          "title": "Description",
          "type": "string"
        },
        "fact_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "关联的事实项 key（如有）",
          "title": "Fact Key"
        },
        "suggested_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "建议处理方式",
          "title": "Suggested Action"
        }
      },
      "required": [
        "severity",
        "category",
        "description"
      ],
      "title": "FactCheckIssue",
      "type": "object"
    },
    "FactCheckRecommendation": {
      "enum": [
        "approve",
        "revise",
        "reject"
      ],
      "title": "FactCheckRecommendation",
      "type": "string"
    },
    "KeyDataPoint": {
      "description": "关键数据点。",
      "properties": {
        "key": {
          "description": "数据指标名称，如 '融资金额'、'估值'、'MMLU分数'",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "description": "数值（字符串形式，保留原文格式）",
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "单位，如 '亿美元'、'%'、'参数'",
          "title": "Unit"
        },
        "is_verified": {
          "default": false,
          "description": "是否经过多源交叉验证",
          "title": "Is Verified",
          "type": "boolean"
        },
        "source_indexes": {
          "description": "支撑该数据的来源索引（对应 sources 数组的下标）",
          "items": {
            "type": "integer"
          },
          "title": "Source Indexes",
          "type": "array"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "KeyDataPoint",
      "type": "object"
    },
    "ResearchEvent": {
      "description": "Agent-1 研究员输出的结构化事件。",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "is_valid": {
          "description": "是否为有效AI事件",
          "title": "Is Valid",
          "type": "boolean"
        },
        "invalid_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Reason"
        },
        "title": {
          "description": "事件标题（一句话概括）",
          "title": "Title",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "summary": {
          "description": "2-3句话的事件摘要",
          "title": "Summary",
          "type": "string"
        },
        "companies": {
          "description": "涉及的公司/机构",
          "items": {
            "type": "string"
          },
          "title": "Companies",
          "type": "array"
        },
        "persons": {
          "description": "涉及的关键人物",
          "items": {
            "type": "string"
          },
          "title": "Persons",
          "type": "array"
        },
        "key_data": {
          "items": {
            "$ref": "#/$defs/KeyDataPoint"
          },
          "title": "Key Data",
          "type": "array"
        },
        "facts": {
          "description": "核心事实列表，3-8条",
          "items": {
            "type": "string"
          },
          "title": "Facts",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "confidence": {
          "description": "整体置信度",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Reason"
        },
        "importance_preliminary": {
          "description": "初步重要性评分",
          "maximum": 100,
          "minimum": 0,
          "title": "Importance Preliminary",
          "type": "integer"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "processed_at": {
          "format": "date-time",
          "title": "Processed At",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "is_valid",
        "title",
        "event_type",
        "summary",
        "confidence",
        "importance_preliminary"
      ],
      "title": "ResearchEvent",
      "type": "object"
    },
    "SourceRef": {
      "description": "来源引用。",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "source_domain": {
          "title": "Source Domain",
          "type": "string"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Name"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "reliability": {
          "$ref": "#/$defs/SourceReliability",
          "default": "unknown"
        },
        "is_official": {
          "default": false,
          "description": "是否官方一手来源",
          "title": "Is Official",
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "url",
        "source_domain"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceReliability": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "SourceReliability",
      "type": "string"
    }
  },
  "description": "Agent-2 事实核查后的事件。",
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "passed": {
      "description": "是否通过核查",
      "title": "Passed",
      "type": "boolean"
    },
    "overall_score": {
      "description": "整体核查分数",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Overall Score",
      "type": "number"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/FactCheckCategoryResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "critical_issues": {
      "items": {
        "$ref": "#/$defs/FactCheckIssue"
      },
      "title": "Critical Issues",
      "type": "array"
    },
    "minor_issues": {
      "items": {
        "$ref": "#/$defs/FactCheckIssue"
      },
      "title": "Minor Issues",
      "type": "array"
    },
    "final_confidence": {
      "description": "最终置信度（核查后）",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Final Confidence",
      "type": "number"
    },
    "recommendation": {
      "$ref": "#/$defs/FactCheckRecommendation"
    },
    "corrected_event": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchEvent"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "修正后的事件（当 recommendation=revise 时填充）"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "passed",
    "overall_score",
    "final_confidence",
    "recommendation"
  ],
  "title": "FactCheckedEvent",
  "type": "object"
}