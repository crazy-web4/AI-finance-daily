# AnySearch API Key
ANYSEARCH_API_KEY=as_sk_your_key_here

# 可选配置
# TIME_WINDOW_HOURS=24
# OUTPUT_DIR=data/reports

# 报告时区（默认 Asia/Shanghai，影响报告日期与时间窗口）
# REPORT_TIMEZONE=Asia/Shanghai

# ── 订阅推送（出报后按订阅发送个性化摘要，可选）──────────────
# 设为 1 时 run_daily.py 出报结束自动推送；也可手动：python main.py digest
# DIGEST_PUSH=1
# Webhook 通道（钉钉/企微机器人或通用 JSON webhook，二选一或复用告警）
# ALERT_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxxx
# 摘要里回到本地看板的链接（手动 digest 可用 --base-url 覆盖）
# DIGEST_BASE_URL=http://127.0.0.1:8910
# 邮件 SMTP 通道（可选；订阅 YAML 里写 emails 才会发）
# DIGEST_SMTP_HOST=smtp.exmail.qq.com
# DIGEST_SMTP_PORT=465
# DIGEST_SMTP_USER=you@yourco.com
# DIGEST_SMTP_PASSWORD=your_smtp_pass
# DIGEST_SMTP_FROM=you@yourco.com
# DIGEST_EMAIL_TO=you@yourco.com
